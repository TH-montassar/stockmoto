{
  "name": "stockmoto",
  "version": "1.0.24",
  "description": "Gestion de stock pièces moto & vélo — إدارة قطع الغيار",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/bump-version.js",
    "build": "electron-builder --win --x64",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.stockmoto.app",
    "productName": "KS-GES-stock",
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KS-GES-stock"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "xlsx": "^0.18.5"
  }
}
